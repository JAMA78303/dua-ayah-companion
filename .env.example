# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (seed scripts, push reminders, Stripe webhook) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Quran Foundation (optional — defaults shown)
QF_API_BASE_URL=https://api.qurancdn.com/api/qdc
QF_USER_API_BASE_URL=https://api.quran.foundation
QF_API_KEY=

NEXT_PUBLIC_URL=http://localhost:3000

# Push reminders (generate keys with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@yourdomain or https://yourdomain
VAPID_SUBJECT=
# Any long random string; Vercel Cron sends it to /api/cron/reminders
CRON_SECRET=

# Supporter subscriptions (Stripe). Leave empty and the Supporter page says "coming soon".
# STRIPE_PRICE_ID is the monthly recurring price (price_...) from your Stripe product.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
